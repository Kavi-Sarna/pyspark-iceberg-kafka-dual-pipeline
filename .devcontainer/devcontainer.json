{
  "name": "dual-mode-pyspark-iceberg-pipeline",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Java because Spark runs on the JVM even though this is a Python project,
  // Python only to bootstrap uv, and docker-in-docker to run the Compose stack.
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // The stack is eighteen services now - Spark, object storage, a catalog, a
  // broker, a registry, and the metrics chain - with a streaming job on top.
  // Two cores cannot do that: everything starts, then the job gets no CPU and
  // the dashboards stay empty while nothing visibly fails.
  //
  // Codespaces bills core-hours at the core count, and GitHub Free includes
  // 120 a month: 60 wall-clock hours on 2 cores, 30 on 4, 15 on 8. For a demo
  // with a six-figure stream, pick 8 at creation and stop it afterwards.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "forwardPorts": [3000, 9090, 9001, 8080, 8081, 18080, 4040, 8085],

  // Ports are private by default. To show someone, set a port to Public in the
  // Ports panel for the duration — the Spark UIs have no authentication, so a
  // public port is an open URL for as long as the codespace runs.
  "portsAttributes": {
    "3000": { "label": "Grafana - streaming dashboard", "onAutoForward": "notify" },
    "9090": { "label": "Prometheus", "onAutoForward": "silent" },
    "9001": { "label": "MinIO console", "onAutoForward": "silent" },
    "8080": { "label": "Spark master UI", "onAutoForward": "notify" },
    "8081": { "label": "Spark worker UI", "onAutoForward": "silent" },
    "18080": { "label": "Spark History Server", "onAutoForward": "silent" },
    "4040": { "label": "Spark driver UI (only while a job runs)", "onAutoForward": "silent" },
    "8085": { "label": "Schema Registry", "onAutoForward": "silent" }
  },

  // Split deliberately: onCreate is the slow one-off build, postStart runs on
  // every resume. A codespace stops after 30 minutes idle, so a create-only
  // hook would leave you with a dead cluster the second time you open it.
  "onCreateCommand": ".devcontainer/on-create.sh",
  "postStartCommand": ".devcontainer/post-start.sh",
  "waitFor": "onCreateCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.mypy-type-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}